---
import Logo from "../ui/Logo.astro";
import { sidebar } from "../../data/sidebar";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
---

<aside 
  id="docs-sidebar-drawer" 
  class="fixed lg:sticky top-20 inset-x-3 sm:inset-x-auto sm:left-6 sm:w-80 lg:w-72 max-h-[85vh] lg:max-h-none lg:h-[calc(100vh-5.5rem)] z-50 lg:z-30 rounded-3xl lg:rounded-none border border-border/80 lg:border-r lg:border-border/40 lg:border-t-0 lg:border-b-0 lg:border-l-0 bg-surface/95 lg:bg-transparent backdrop-blur-2xl lg:backdrop-blur-none p-4 sm:p-5 lg:py-6 lg:pr-6 lg:pl-0 flex flex-col justify-between opacity-0 pointer-events-none -translate-y-2 lg:opacity-100 lg:pointer-events-auto lg:translate-y-0 transition-all duration-200 ease-out shrink-0 shadow-2xl lg:shadow-none"
  aria-label="Documentation Navigation"
>
  <div class="flex lg:hidden items-center justify-between pb-3.5 mb-3 border-b border-border/50 shrink-0">
    <a href="/" class="flex items-center gap-2 group">
      <Logo />
      <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-[#299C45]/15 text-[#299C45] border border-[#299C45]/30 font-mono">
        Docs
      </span>
    </a>
    <button 
      id="close-sidebar-btn" 
      type="button" 
      class="p-2 text-text-muted hover:text-text rounded-full hover:bg-surface-2 transition-colors cursor-pointer border border-border/40"
      aria-label="Close Documentation Menu"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="block sm:hidden mb-3 shrink-0">
    <button
      id="drawer-search-trigger-btn"
      type="button"
      class="w-full flex items-center justify-between px-4 py-2 text-xs text-text-muted bg-surface-2/70 hover:bg-surface-2 border border-border rounded-full transition-all group"
    >
      <span class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-text-muted group-hover:text-[#299C45] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search docs...</span>
      </span>
      <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-surface rounded-full border border-border text-text-muted">Ctrl K</kbd>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto space-y-5 pr-1.5 scrollbar-thin select-none">
    {sidebar.map(section => {
      const isSectionActive = section.items.some(item => item.href.endsWith(`/${currentSlug}`) || (currentSlug === 'introduction' && item.href === '/docs/introduction'));
      
      return (
        <div class="sidebar-section" data-section-id={section.id}>
          <button
            type="button"
            class="sidebar-toggle-btn flex items-center justify-between w-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted hover:text-text transition-colors rounded-full hover:bg-surface-2/60 group cursor-pointer font-mono"
            data-target={section.id}
            aria-expanded={isSectionActive ? "true" : "true"}
          >
            <span class="flex items-center gap-2">
              <span class="text-[#299C45] text-sm flex items-center">
                {section.iconName === 'rocket' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                    <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                  </svg>
                )}
                {section.iconName === 'layers' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                    <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
                    <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
                  </svg>
                )}
                {section.iconName === 'package' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
                    <path d="M12 22V12"/>
                    <polyline points="3.29 7 12 12 20.71 7"/>
                    <path d="m7.5 4.27 9 5.15"/>
                  </svg>
                )}
                {section.iconName === 'code' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                )}
                {section.iconName === 'settings' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                )}
              </span>
              <span class="group-hover:text-text transition-colors">{section.title}</span>
            </span>
            <span class="chevron-icon text-[10px] text-text-dim group-hover:text-text-muted transition-transform duration-200">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </button>

          <ul id={`sidebar-list-${section.id}`} class="mt-1 space-y-1 pl-2.5 border-l border-border/50 ml-3">
            {section.items.map(item => {
              const itemSlug = item.href.replace("/docs/", "");
              const isActive = currentSlug === itemSlug || (currentSlug === "" && itemSlug === "introduction");
              
              return (
                <li>
                  <a 
                    href={item.href} 
                    class:list={[
                      "group flex items-center justify-between px-3.5 py-1.5 text-sm rounded-full transition-all duration-150 font-mono text-[13px] relative border",
                      isActive 
                        ? "bg-[#299C45]/15 text-[#299C45] border-[#299C45]/35 shadow-sm" 
                        : "text-text-muted hover:text-text hover:bg-surface-2/70 border-transparent"
                    ]}
                  >
                    <span class="truncate">{item.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </nav>

  <div class="shrink-0 pt-4 border-t border-border/40">
    <div class="h-[108px] p-3.5 rounded-2xl bg-surface-2/40 border border-border/60 text-xs text-text-muted flex flex-col justify-between">
      <div class="flex items-center gap-1.5 text-[#299C45] font-semibold font-mono">
        <svg class="w-3.5 h-3.5 text-[#299C45]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        <span>Nitro Quick Tip</span>
      </div>
      <p class="leading-relaxed text-[11.5px]">Press <kbd class="px-1.5 py-0.5 bg-surface rounded-full border border-border text-text-muted font-mono text-[10px]">SUPER + Space</kbd> to toggle the app launcher anywhere.</p>
    </div>
  </div>
</aside>

<div 
  id="sidebar-backdrop" 
  class="fixed inset-0 bg-black/75 backdrop-blur-md z-40 hidden lg:hidden transition-opacity duration-200"
></div>

<script>
  function setupSidebar() {
    const openBtn = document.getElementById("open-sidebar-btn");
    const closeBtn = document.getElementById("close-sidebar-btn");
    const sidebarDrawer = document.getElementById("docs-sidebar-drawer");
    const backdrop = document.getElementById("sidebar-backdrop");
    const drawerSearchBtn = document.getElementById("drawer-search-trigger-btn");
    const mainSearchBtn = document.getElementById("search-trigger-btn");

    function openSidebar() {
      sidebarDrawer?.classList.remove("opacity-0", "pointer-events-none", "-translate-y-2");
      sidebarDrawer?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      backdrop?.classList.remove("hidden");
      document.body.classList.add("overflow-hidden", "lg:overflow-auto");
    }

    function closeSidebar() {
      sidebarDrawer?.classList.add("opacity-0", "pointer-events-none", "-translate-y-2");
      sidebarDrawer?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      backdrop?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden", "lg:overflow-auto");
    }

    openBtn?.addEventListener("click", openSidebar);
    closeBtn?.addEventListener("click", closeSidebar);
    backdrop?.addEventListener("click", closeSidebar);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeSidebar();
      }
    });

    drawerSearchBtn?.addEventListener("click", () => {
      closeSidebar();
      mainSearchBtn?.click();
    });

    document.querySelectorAll(".sidebar-toggle-btn").forEach(btn => {
      const button = btn as HTMLButtonElement;
      const targetId = button.dataset.target;
      const list = document.getElementById(`sidebar-list-${targetId}`);
      const chevron = button.querySelector(".chevron-icon") as HTMLElement;

      button.addEventListener("click", () => {
        const isHidden = list?.classList.toggle("hidden");
        if (chevron) {
          chevron.style.transform = isHidden ? "rotate(-90deg)" : "rotate(0deg)";
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupSidebar);
  } else {
    setupSidebar();
  }
  document.addEventListener("astro:page-load", setupSidebar);
</script>
