---
import type { DocHeading } from "../../data/docsContent";

interface Props {
  headings: DocHeading[];
  slug: string;
}

const { headings, slug } = Astro.props;
---

<aside 
  id="docs-toc-container" 
  class="hidden xl:flex flex-col w-64 h-[calc(100vh-5.5rem)] sticky top-20 py-6 pl-5 pr-2 text-sm shrink-0 select-none justify-between"
  aria-label="Table of contents"
>
  <div class="flex-1 overflow-y-auto space-y-3 pr-1 scrollbar-thin">
    <div class="flex items-center gap-2 pb-1 text-xs font-semibold uppercase tracking-wider text-text-muted font-mono">
      <svg class="w-3.5 h-3.5 text-[#299C45]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h.01M8 6h12M4 12h.01M8 12h12M4 18h.01M8 18h12" />
      </svg>
      <span>On this page</span>
    </div>

    {headings && headings.length > 0 ? (
      <nav class="relative pl-2.5 border-l border-border/50 space-y-0.5 font-sans" id="toc-nav">
        <div 
          id="toc-marker" 
          class="absolute -left-[1px] w-[2px] bg-[#299C45] rounded-full transition-all duration-200 ease-out opacity-0 pointer-events-none"
          style="height: 24px; top: 0;"
        ></div>

        {headings.map(heading => (
          <a 
            href={`#${heading.id}`}
            class:list={[
              "toc-link group flex items-center justify-between text-[13px] leading-snug py-1.5 px-2 rounded-md transition-all duration-150 relative",
              heading.level === 3 ? "pl-5 text-xs text-text-dim" : "text-text-muted hover:text-text",
              "hover:bg-surface-2/60"
            ]}
            data-heading-id={heading.id}
          >
            <span class="truncate">{heading.text}</span>
          </a>
        ))}
      </nav>
    ) : (
      <p class="text-xs text-text-dim pl-2 font-mono">Overview</p>
    )}
  </div>

  <div class="shrink-0 pt-4 border-t border-border/40">
    <div class="h-[108px] p-3.5 rounded-2xl bg-surface-2/40 border border-border/60 text-xs text-text-muted flex flex-col justify-between">
      <button 
        id="toc-back-to-top"
        type="button"
        class="flex items-center justify-between text-text-dim hover:text-text transition-colors group cursor-pointer w-full text-left"
      >
        <span>Back to top</span>
        <svg class="w-3.5 h-3.5 text-text-dim group-hover:text-[#299C45] transition-transform duration-150 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>

      <a 
        href={`https://github.com/Nitro-OS/nitro-os.github.io/issues/new?title=Docs%20feedback%20for%20${slug}`}
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between text-text-dim hover:text-text transition-colors group"
      >
        <span>Give feedback</span>
        <svg class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <a 
        href="https://github.com/Nitro-OS/nitro-os.github.io" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between text-text-dim hover:text-text transition-colors group"
      >
        <span>Star on GitHub</span>
        <svg class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition-opacity text-amber-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      </a>
    </div>
  </div>
</aside>

<script>
  function initTOC() {
    const tocNav = document.getElementById("toc-nav");
    const marker = document.getElementById("toc-marker");
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    const backToTopBtn = document.getElementById("toc-back-to-top");

    if (!links.length) return;

    const validHeadings: HTMLElement[] = [];
    links.forEach(link => {
      const id = link.dataset.headingId;
      if (id) {
        const el = document.getElementById(id);
        if (el) validHeadings.push(el);
      }
    });

    if (!validHeadings.length) return;

    let activeId = "";
    let isClickScrolling = false;
    let clickScrollTimer: number | null = null;

    function updateActiveHeading() {
      if (isClickScrolling) return;

      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;

      if (scrollY + windowHeight >= docHeight - 70) {
        const lastHeading = validHeadings[validHeadings.length - 1];
        if (lastHeading) {
          setActive(lastHeading.id);
          return;
        }
      }

      const threshold = 140;
      let currentHeading = validHeadings[0];

      for (let i = 0; i < validHeadings.length; i++) {
        const heading = validHeadings[i];
        const rect = heading.getBoundingClientRect();
        if (rect.top <= threshold) {
          currentHeading = heading;
        } else {
          break;
        }
      }

      if (currentHeading) {
        setActive(currentHeading.id);
      }
    }

    function setActive(id: string) {
      if (activeId === id) return;
      activeId = id;

      let activeLink: HTMLAnchorElement | null = null;

      links.forEach((link) => {
        const isCurrent = link.dataset.headingId === id;
        if (isCurrent) {
          activeLink = link;
          link.classList.add("text-[#299C45]", "bg-[#299C45]/10");
          link.classList.remove("text-text-muted", "text-text-dim");
        } else {
          link.classList.remove("text-[#299C45]", "bg-[#299C45]/10");
          if (link.classList.contains("pl-5")) {
            link.classList.add("text-text-dim");
          } else {
            link.classList.add("text-text-muted");
          }
        }
      });

      if (marker && tocNav && activeLink) {
        const navRect = tocNav.getBoundingClientRect();
        const linkRect = (activeLink as HTMLElement).getBoundingClientRect();
        const topOffset = linkRect.top - navRect.top;
        
        marker.style.top = `${topOffset}px`;
        marker.style.height = `${linkRect.height}px`;
        marker.style.opacity = "1";
      }

      const tocContainer = document.getElementById("docs-toc-container");
      if (tocContainer && activeLink) {
        const linkTop = (activeLink as HTMLElement).offsetTop;
        const linkHeight = (activeLink as HTMLElement).offsetHeight;
        const containerScroll = tocContainer.scrollTop;
        const containerHeight = tocContainer.clientHeight;

        if (linkTop < containerScroll || linkTop + linkHeight > containerScroll + containerHeight) {
          tocContainer.scrollTo({
            top: linkTop - containerHeight / 2,
            behavior: "smooth"
          });
        }
      }
    }

    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        const targetId = link.dataset.headingId;
        if (!targetId) return;
        
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          e.preventDefault();

          isClickScrolling = true;
          if (clickScrollTimer) clearTimeout(clickScrollTimer);

          targetElement.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });

          history.pushState(null, "", `#${targetId}`);
          setActive(targetId);

          clickScrollTimer = window.setTimeout(() => {
            isClickScrolling = false;
          }, 700);
        }
      });
    });

    if (backToTopBtn) {
      backToTopBtn.addEventListener("click", () => {
        isClickScrolling = true;
        if (clickScrollTimer) clearTimeout(clickScrollTimer);
        window.scrollTo({ top: 0, behavior: "smooth" });
        if (validHeadings[0]) setActive(validHeadings[0].id);
        clickScrollTimer = window.setTimeout(() => {
          isClickScrolling = false;
        }, 700);
      });
    }

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    updateActiveHeading();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTOC);
  } else {
    initTOC();
  }
  document.addEventListener("astro:page-load", initTOC);
</script>
