---
import { ecosystemUtilities as utilities } from "../../data/ecosystem";
import { ArrowRight } from "@lucide/astro";
---

<section id="tools" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 max-w-xl">
      <p class="mb-3 text-[13.5px] font-semibold tracking-wide text-accent">Tools &amp; ecosystem</p>
      <h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        The built-in toolkit.
      </h2>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      <div class="rounded-2xl border border-border bg-surface p-7 flex flex-col justify-between hover:border-accent/40 transition-all duration-200 shadow-sm group">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-accent">01 · Editor</p>
          <h3 class="mb-2 font-display text-2xl font-semibold text-text group-hover:text-accent transition-colors">NitroVim</h3>
          <p class="text-[15px] leading-relaxed text-text-muted">
            A modal, keyboard-driven development environment tuned for sub-millisecond startup, Treesitter syntax, Mason LSP management, and DAP debugging.
          </p>
        </div>

        <a 
          href="/docs/nitrovim" 
          class="inline-flex items-center gap-2 text-xs font-semibold text-text-muted hover:text-accent transition-colors pt-6 border-t border-border/60 mt-6"
        >
          <span>Explore NitroVim</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-7 flex flex-col justify-between hover:border-accent/40 transition-all duration-200 shadow-sm group">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-accent">02 · Package Manager</p>
          <h3 class="mb-2 font-display text-2xl font-semibold text-text group-hover:text-accent transition-colors">NitroPkg (npk)</h3>
          <p class="text-[15px] leading-relaxed text-text-muted">
            The native high-speed package manager engineered in Rust. Search, install, update, and manage dependencies with parallel multi-worker downloads.
          </p>
        </div>

        <a 
          href="/docs/npk-overview" 
          class="inline-flex items-center gap-2 text-xs font-semibold text-text-muted hover:text-accent transition-colors pt-6 border-t border-border/60 mt-6"
        >
          <span>Explore NitroPkg</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-7 flex flex-col justify-between hover:border-accent/40 transition-all duration-200 shadow-sm group">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-accent">03 · API Client</p>
          <h3 class="mb-2 font-display text-2xl font-semibold text-text group-hover:text-accent transition-colors">NitroHttp</h3>
          <p class="text-[15px] leading-relaxed text-text-muted">
            A developer HTTP and REST/GraphQL client. Execute fast commands directly with nhttp or inspect JSON payloads, headers, and response latency.
          </p>
        </div>

        <a 
          href="/docs/nitrohttp" 
          class="inline-flex items-center gap-2 text-xs font-semibold text-text-muted hover:text-accent transition-colors pt-6 border-t border-border/60 mt-6"
        >
          <span>Explore NitroHttp</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        utilities.map((u) => (
          <div class="rounded-xl border border-border bg-surface p-6 hover:border-border-strong transition-colors">
            <h3 class="mb-2 font-display text-[17px] font-medium text-text">{u.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-text-muted">{u.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
