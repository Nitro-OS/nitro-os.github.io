---
import { features } from "../../data/features";
---

<section id="features" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 max-w-xl">
      <p class="mb-3 text-[13.5px] font-semibold tracking-wide text-accent">Features</p>
      <h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        Everything tuned. Nothing extra.
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => {
          const Icon = f.icon;
          return (
            <div class="group rounded-2xl border border-border bg-surface p-7 transition-all duration-200 hover:border-accent/40 hover:shadow-sm">
              <Icon
                size={36}
                stroke-width={1.8}
                class="mb-5 text-accent"
                aria-hidden="true"
              />
              <h3 class="mb-2 font-display text-[18.5px] font-medium text-text group-hover:text-accent transition-colors">{f.title}</h3>
              <p class="text-[15px] leading-relaxed text-text-muted">{f.desc}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
