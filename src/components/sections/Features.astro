---
import { features } from "../../data/features";
---

<section id="features" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 max-w-xl">
      <p class="mb-3 font-mono text-[13.5px] tracking-wide text-accent">Features</p>
      <h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        Everything tuned. Nothing extra.
      </h2>
    </div>

    <div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => {
          const Icon = f.icon;
          return (
            <div class="group bg-bg px-7 py-8 transition-colors hover:bg-surface">
              <Icon
                size={40}
                stroke-width={1.8}
                class="mb-5 text-accent"
                aria-hidden="true"
              />
              <h3 class="mb-2 font-display text-[18.5px] font-medium text-text">{f.title}</h3>
              <p class="text-[15.5px] leading-relaxed text-text-muted">{f.desc}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
