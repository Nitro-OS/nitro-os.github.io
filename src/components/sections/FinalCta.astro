---
import Button from "../ui/Button.astro";
---

<section id="download" class="noise-veil border-t border-border px-6 py-28 sm:px-8">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <h2 class="text-balance font-display text-4xl font-semibold tracking-tight text-text sm:text-5xl">
      The OS that stays out of your way.
    </h2>
    <p class="mt-5 max-w-md text-[15px] leading-relaxed text-text-muted">
      Free, open, and ready to install. Bring your own hardware — Nitro OS
      handles the rest.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href="#" variant="primary">Download Nitro OS</Button>
      <Button href="#tools" variant="secondary">View documentation</Button>
    </div>
  </div>
</section>
