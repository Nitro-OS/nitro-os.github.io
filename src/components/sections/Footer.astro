---
import Logo from "../ui/Logo.astro";
import { footerCols as cols } from "../../data/navigation";
---

<footer class="border-t border-border px-6 py-16 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(3,1fr)]">
      <div>
        <Logo class="text-text" />
        <p class="mt-4 max-w-55 text-[13.5px] leading-relaxed text-text-muted">
          A minimal, modern Linux distribution for power users.
        </p>
      </div>

      {
        cols.map((col) => (
          <div>
            <p class="mb-4 font-mono text-[12px] text-text-dim">{col.heading}</p>
            <ul class="flex flex-col gap-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={!link.href ? "_blank" : ""}
                    class="text-[13.5px] text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[12px] text-text-dim">© 2026 Nitro OS. Open source, always.</p>
      <p class="font-mono text-[12px] text-text-dim">Built for speed, control, and polish.</p>
    </div>
  </div>
</footer>
