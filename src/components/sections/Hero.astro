---
import Button from "../ui/Button.astro";
---

<section class="noise-veil relative overflow-hidden px-6 pt-36 pb-28 sm:px-8 sm:pt-44 sm:pb-36">
  <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
    
    <div class="relative mb-10 flex items-center justify-center">
      <div 
        class="absolute -inset-24 -z-10 rounded-full bg-accent/10 blur-3xl opacity-80" 
        aria-hidden="true"
      ></div>
      <img
        src="/images/logo.png"
        alt="Nitro OS Logo"
        width="240"
        height="240"
        class="relative z-10 h-[240px] w-[240px] object-contain filter drop-shadow-[0_0_40px_rgba(41,156,69,0.35)]"
      />
    </div>

    <h1 class="text-balance font-display text-[64px] font-black uppercase tracking-wide leading-[0.95] text-text sm:text-[96px] md:text-[110px]">
      Nitro <span class="bg-gradient-to-r from-accent to-emerald-400 bg-clip-text text-transparent">OS</span>
    </h1>

    <p class="mt-8 max-w-2xl text-balance font-display text-xl font-medium leading-snug text-text sm:text-2xl">
      A modern Linux experience for power users.
    </p>

    <p class="mt-4 max-w-xl text-[17px] leading-relaxed text-text-muted">
      A high-performance, modal-first Linux distribution engineered for absolute speed. 
      Zero background bloat, keyboard-driven interface layers, and native developer defaults 
      — crafted to give you absolute control over your machine.
    </p>

    <div class="mt-10 flex flex-wrap justify-center items-center gap-3">
      <Button href="#download" variant="primary">Download Nitro OS</Button>
      <Button href="#features" variant="secondary">Explore features</Button>
    </div>

  </div>
</section>
