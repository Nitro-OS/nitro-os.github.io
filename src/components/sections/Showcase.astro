---
import ShowcaseTabs from "../solid/ShowcaseTabs.tsx";
---

<section id="showcase" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-xl">
      <p class="mb-3 font-mono text-[13.5px] tracking-wide text-accent">Showcase</p>
      <h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        See it in motion.
      </h2>
      <p class="mt-4 text-[16.5px] leading-relaxed text-text-muted">
        Every surface of Nitro OS, from the desktop to the package manager.
      </p>
    </div>

    <ShowcaseTabs client:visible />
  </div>
</section>
