---
interface Props {
  class?: string;
  markOnly?: boolean;
}

const { class: className = "", markOnly = false } = Astro.props;
---

<div class={`flex items-center gap-2.5 ${className}`}>
  <img
    src="/images/logo.png"
    alt="Nitro OS Logo"
    width="22"
    height="22"
    class="h-[22px] w-[22px] object-contain shrink-0"
  />
  {
    !markOnly && (
      <span class="font-display text-[15px] font-semibold tracking-tight text-text">
        Nitro<span class="text-text-muted font-medium">OS</span>
      </span>
    )
  }
</div>
