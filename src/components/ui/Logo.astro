---
import LogoIcon from "./LogoIcon.astro";

interface Props {
  class?: string;
  markOnly?: boolean;
}

const { class: className = "", markOnly = false } = Astro.props;
---

<div class={`flex items-center gap-3 ${className}`}>
  <LogoIcon size="28" />
  {
    !markOnly && (
      <span class="font-display text-[17.5px] font-semibold tracking-tight text-text">
        Nitro<span class="text-text-muted font-medium">OS</span>
      </span>
    )
  }
</div>
