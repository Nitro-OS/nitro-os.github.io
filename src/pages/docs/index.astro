---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsData } from '../../data/docsContent';

const docs = await getCollection('docs');
const entry = docs.find(d => d.id.replace(/\.mdx?$/, '') === 'introduction') || docs[0];

if (!entry) {
  return Astro.redirect('/docs/introduction');
}

const { Content } = await render(entry);
const docData = docsData['introduction'];
---

<DocsLayout slug="introduction">
  <article class="doc-content prose prose-invert max-w-none space-y-12">
    <Content />

    {docData && (docData.prev || docData.next) && (
      <footer class="pt-10 mt-12 border-t border-border/50">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {docData.prev ? (
            <a 
              href={docData.prev.href} 
              class="group flex flex-col p-4 sm:p-5 rounded-2xl bg-surface/40 hover:bg-surface-2/70 border border-border/70 hover:border-[#299C45]/50 transition-all duration-200 shadow-sm hover:shadow-md relative overflow-hidden"
            >
              <div class="flex items-center gap-1.5 text-text-dim text-xs font-mono font-medium mb-1.5 transition-colors group-hover:text-[#299C45]">
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                <span>Previous</span>
              </div>
              <span class="text-sm sm:text-base font-semibold text-text group-hover:text-[#299C45] transition-colors leading-snug">
                {docData.prev.title}
              </span>
            </a>
          ) : <div class="hidden sm:block" />}

          {docData.next ? (
            <a 
              href={docData.next.href} 
              class="group flex flex-col items-end text-right p-4 sm:p-5 rounded-2xl bg-surface/40 hover:bg-surface-2/70 border border-border/70 hover:border-[#299C45]/50 transition-all duration-200 shadow-sm hover:shadow-md relative overflow-hidden"
            >
              <div class="flex items-center gap-1.5 text-text-dim text-xs font-mono font-medium mb-1.5 transition-colors group-hover:text-[#299C45]">
                <span>Next</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <span class="text-sm sm:text-base font-semibold text-text group-hover:text-[#299C45] transition-colors leading-snug">
                {docData.next.title}
              </span>
            </a>
          ) : null}
        </div>
      </footer>
    )}
  </article>
</DocsLayout>
